# Copy to .env and fill in. .env itself is never committed (see .gitignore) —
# it's copied to the VM by setup.sh over ssh, not tracked in git.

DOMAIN=example.com
SCHEME=https              # http for local testing without TLS; https once deployed
AUTH_HOST=auth.example.com  # conventionally auth.$DOMAIN, kept explicit rather than derived

POSTGRES_PASSWORD=changeme
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme

# Host paths for the two bind-mount roots: workspace is git-tracked app
# code; data is not (postgres/keycloak runtime state).
WORKSPACE_DIR=/srv/mold/workspace
DATA_DIR=/srv/mold/data
